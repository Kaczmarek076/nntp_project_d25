<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:nntp_project_d25.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="nntp_project_d25.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="nntp_project_d25">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>


    <StackPanel Orientation="Horizontal">
        <StackPanel Margin="20" Spacing="10">
            <TextBox x:Name="CommandTextBox"
                     Text="{Binding CommandList}"
                     Foreground="Green"
                     Background="Black"
                     FontSize="12"
                     Width="1250"
                     Height="500"
                     AcceptsReturn="True"
                     TextWrapping="Wrap">
            </TextBox>
            <TextBox PlaceholderText="Commands"
                     Text="{Binding IndputCommand}"
                     KeyDown="InputElement_OnKeyDown">
            </TextBox>
        </StackPanel>
        <StackPanel>
            <TextBox PlaceholderText="Username" Text="{Binding Username}"></TextBox>
            <TextBox PlaceholderText="Password" Text="{Binding Password}"></TextBox>
            <Button Content="Login" Click="Button_Login"></Button>
        </StackPanel>
    </StackPanel>
</Window>