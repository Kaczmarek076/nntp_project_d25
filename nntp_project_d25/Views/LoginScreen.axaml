<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:nntp_project_d25.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="nntp_project_d25.Views.LoginScreen"
        x:DataType="viewModels:LoginViewModel"
        Title="LoginScreen">
        
        <StackPanel>
                <TextBox PlaceholderText="Serverhost Name" Text="{Binding ServerHostName}"></TextBox>
                <TextBox PlaceholderText="Port" Text="{Binding Port}"></TextBox>
                <Button Content="Log In" Click="Button_OnClick"></Button>
        </StackPanel>
</Window>
